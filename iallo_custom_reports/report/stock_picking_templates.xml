<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <template id="l10n_ar_report_remito_r_document">
            <t t-call="web.html_container">
                <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)" />
                    <t t-set="partner" t-value="o.partner_id or False"/>
                    <div class="row">
                        <div class="col-12 page" style="margin-top: 110px;">
                            <div class="row" name="picking_dates">
                                <div class="col-11 text-right" t-if="o.state" name="date_done" style="font-size: 12px !important;">
                                    <t t-if="o.state == 'done'">
                                        <p t-field="o.date_done" t-options='{"format": "dd   MM   yyyy"}'/>
                                    </t>
                                </div>
                                <div class="col-1">

                                </div>
                            </div>
                            <div class="row" style="margin-bottom: 20px; margin-top: 100px;">
                                <div class="col-8" name="partner_header">
                                    <div t-if="partner" name="partner_data">
                                        <div style="font-size: 12px !important;" t-field="partner.commercial_partner_id"
                                            t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
                                        <span style="font-size: 12px !important;" t-out="partner" 
                                            t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                        <div style="font-size: 12px !important;" t-field="partner.commercial_partner_id"
                                            t-options='{"widget": "contact", "fields": ["phone"], "no_marker": True, "phone_icons": True}'/>
                                        <span style="font-size: 12px !important;" t-field="partner.delivery_description"/>
                                    </div>
                                </div>
                                <div class="col-4" name="fiscal_data">
                                    <div t-if="partner.sudo().commercial_partner_id.vat" style="font-size: 12px !important;  margin-bottom: 20px;">
                                        <t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="partner.sudo().commercial_partner_id.vat"/>
                                    </div>
                                    <div style="font-size: 12px !important;">
                                        <strong>Transporte:</strong>
                                        <span t-if="o.carrier_id" t-esc="o.carrier_id.name"/>
                                    </div>
                                    <div style="font-size: 12px !important;">
                                        <strong>Valor Declarado:</strong>
                                        <span t-if="o.declared_value" t-esc="o.declared_value"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" name="table">
                                    <table class="table table-sm" t-if="o.state=='done'" name="stock_move_table" style="font-size: 12px !important; width: 100% !important">
                                        <thead>
                                            <tr style="background-color: #ccc !important; color: white !important;">
                                                <th class="text-left" name="th_product" style="width: 55% !important;">
                                                    <strong>Descripción</strong>
                                                </th>
                                                <th class="text-left" style="width: 10% !important;"><span>Lote</span></th>
                                                <th class="text-left" style="width: 10% !important;"><span>Despacho</span></th>
                                                <th class="text-right" name="th_quantity" style="width: 10% !important;">
                                                    <strong>Cantidad</strong>
                                                </th>
                                                <th class="text-left" name="th_uom" style="width: 15% !important;">
                                                    <strong>Unidad Medida</strong>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="lines" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                                            <t t-foreach="lines" t-as="move">
                                                <tr style=" font-size: 12px !important; border-top: 0px !important; border-bottom: 0px !important; line-height: 12px !important; height: 12px !important;">
                                                    <td colspan="3" class="text-left" style="border-top: 0px !important; border-bottom: 0px !important;">
                                                        <span t-field="move.product_id"/>
                                                        <p t-if="move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                                            <span t-field="move.description_picking"/>
                                                        </p>
                                                    </td>
                                                    <td class="text-right" style="border-top: 0px !important; border-bottom: 0px !important;">
                                                        <span t-field="move.quantity_done"/>
                                                    </td>
                                                    <td class="text-left" style="border-top: 0px !important; border-bottom: 0px !important;">
                                                        <span t-field="move.product_uom"/>
                                                    </td>
                                                </tr>
                                                <t t-if="move.move_line_ids" t-foreach="move.move_line_ids" t-as="lot">
                                                    <tr style="border-top: 0px !important; border-bottom: 0px !important; font-size: 9px !important; line-height: 10px !important; height: 10px !important">
                                                        <td style="border-top: 0px !important; border-bottom: 0px !important;"> </td>
                                                        <td class="text-left" style="border-top: 0px !important; border-bottom: 0px !important;">
                                                            <span t-field="lot.lot_id.name"/>
                                                        </td>
                                                        <td class="text-left" style="border-top: 0px !important; border-bottom: 0px !important;">
                                                            <t t-if="lot.lot_id.dispatch_number">
                                                                <span t-field="lot.lot_id.dispatch_number"/>
                                                            </t>
                                                        </td>
                                                        <td class="text-right" style="border-top: 0px !important; border-bottom: 0px !important;"><span t-field="lot.qty_done"/></td>
                                                        <td style="border-top: 0px !important; border-bottom: 0px !important;"> </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row mt32">
                                <div class="col-12" name="table">
                                    <table class="table table-borderless table-sm" t-if="o.state=='done'" name="signature_table" style="font-size: 12px !important; width: 100% !important">
                                        <thead>
                                            <tr>
                                                <th width="25%">Recibí conforme:</th>
                                                <th width="25%"></th>
                                                <th width="25%"></th>
                                                <th width="25%"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <th style="text-align: center;">____ / ____ / ____</th>
                                                <td>
                                                    <hr style="border: 1px solid #000000;"/>
                                                </td>
                                                <td>
                                                    <hr style="border: 1px solid #000000;"/>
                                                </td>
                                                <td>
                                                    <hr style="border: 1px solid #000000;"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th style="text-align: center;">Fecha</th>
                                                <th style="text-align: center;">DNI</th>
                                                <th style="text-align: center;">Firma</th>
                                                <th style="text-align: center;">Aclaración</th>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
             </t>
        </template>


        <template id="l10n_ar_report_remito_r">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="iallo_custom_reports.l10n_ar_report_remito_r_document" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
