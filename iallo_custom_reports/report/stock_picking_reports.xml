<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="l10n_ar_stock_picking_afip_remito" model="ir.actions.report">
            <field name="name">AFIP - Remito R</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">iallo_custom_reports.l10n_ar_report_remito_r</field>
            <field name="report_file">iallo_custom_reports.l10n_ar_report_remito_r</field>
            <field name="paperformat_id" ref="l10n_ar_afip_vertical_a4"/>
            <field name="attachment">(object.state == 'done') and ((object.voucher_ids and 'R-'+object.voucher_ids[0].name or ''))+'.pdf'</field>
            <field name="print_report_name">(object.state == 'done') and ((object.voucher_ids and 'R-'+object.voucher_ids[0].name or ''))+'.pdf'</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>

